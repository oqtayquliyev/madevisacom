{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "madevisacom",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // the Worker decides routing (middleware, SEO rewrites) exactly like vercel.json did
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // share images: Cloudflare-compatible stand-in for @vercel/og (same API)
  "alias": { "@vercel/og": "./worker/og.ts" },
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }],
  "keep_vars": true,
  "observability": { "enabled": true }
}
