{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "madevisacom",
  "main": "worker/index.ts",
  "account_id": "1a752544339eab3bf8a3bb7a633df2df",
  "compatibility_date": "2026-09-01",
  // Builds public/js (the small browser scripts) before every `wrangler deploy` / `wrangler dev`.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Files in public/ are served straight away (free, no Worker request); everything else runs the Worker.
    "run_worker_first": false,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // The database. Create it once (SETUP.md, step 2) and paste its "Database ID" here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "madevisa",
      "database_id": "f303152e-355a-4f77-b855-595d824aca73"
    }
  ],
  "vars": {
    // The GitHub repository whose daily job cycle may write into the database (worker/sync.ts).
    "GITHUB_REPO": "oqtayquliyev/madevisacom",
    // Cloudflare Access in front of /admin (Zero Trust → Access → Applications → "MadeVisa admin").
    // Not secrets: the team address and the application's AUD tag, used to check Access's signed pass.
    "ACCESS_TEAM_DOMAIN": "weathered-voice-e8da.cloudflareaccess.com",
    "ACCESS_AUD": "653e9c8a1e188e1217972c97a493f0c093bf963779fb2ba393a8529a44833aa2"
  },
  "keep_vars": true,
  "observability": { "enabled": true }
}
