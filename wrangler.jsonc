{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "madevisacom",
  "main": "worker/index.ts",
  "account_id": "1a752544339eab3bf8a3bb7a633df2df",
  "compatibility_date": "2026-09-01",
  // Builds public/js (the small browser scripts) before every `wrangler deploy` / `wrangler dev`.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Files in public/ are served straight away (free, no Worker request); everything else runs the Worker.
    "run_worker_first": false,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // The database. Create it once (SETUP.md, step 2) and paste its "Database ID" here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "madevisa",
      "database_id": "f303152e-355a-4f77-b855-595d824aca73"
    }
  ],
  // Daily backup trigger for the job cycle (05:41 UTC). Uses 1 of the 5 free cron triggers.
  // It only does something when the GITHUB_TOKEN secret is set (SETUP.md, step 6).
  "triggers": { "crons": ["41 5 * * *"] },
  "vars": {
    // Your GitHub repository, as owner/name.
    "GITHUB_REPO": "oqtayquliyev/madevisacom"
  },
  "keep_vars": true,
  "observability": { "enabled": true }
}
