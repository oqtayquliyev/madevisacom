{
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "https://res.cloudinary.com/dkvg0oo8c/image/upload/v1789558197/madevisa-fav_j8ot2d.png"
    },
    {
      "source": "/apple-touch-icon.png",
      "destination": "https://res.cloudinary.com/dkvg0oo8c/image/upload/c_pad,w_180,h_180,b_white/v1789558197/madevisa-fav_j8ot2d.png"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap?f=index"
    },
    {
      "source": "/sitemaps/:name.xml",
      "destination": "/api/sitemap?f=:name"
    },
    {
      "source": "/j/:a",
      "destination": "/api/seo?r=short&a=:a"
    },
    {
      "source": "/",
      "destination": "/api/seo?r=home"
    },
    {
      "source": "/jobs",
      "destination": "/api/seo?r=jobs"
    },
    {
      "source": "/jobs/:a/:b",
      "destination": "/api/seo?r=job&a=:a&b=:b"
    },
    {
      "source": "/jobs/:a",
      "destination": "/api/seo?r=job&a=:a"
    },
    {
      "source": "/companies/:s",
      "destination": "/api/seo?r=company&s=:s"
    },
    {
      "source": "/destinations/:s",
      "destination": "/api/seo?r=destination&s=:s"
    },
    {
      "source": "/blog",
      "destination": "/api/seo?r=blog"
    },
    {
      "source": "/blog/:s",
      "destination": "/api/seo?r=article&s=:s"
    },
    {
      "source": "/:s(about|how-it-works|pricing|book|cv-match|job-market|contact|privacy|terms|cookies|disclaimer|advertising-policy|sponsored-listing-terms|subscription-terms|sponsorship-document-terms|editorial-policy|corrections|verification-policy|companies|destinations|ghostgood|network|programs|study|offers|official-sources)",
      "destination": "/api/seo?r=page&s=:s"
    },
    {
      "source": "/assets/:path*",
      "destination": "/api/missing-asset"
    },
    {
      "source": "/:p((?!api/|assets/).*)",
      "destination": "/api/seo?r=spa&p=:p"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=()"
        }
      ]
    }
  ],
  "functions": {
    "api/facets.ts": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/feedback",
      "destination": "/ghostgood",
      "permanent": true
    },
    {
      "source": "/feedback/:s",
      "destination": "/ghostgood/:s",
      "permanent": true
    },
    {
      "source": "/official-partners",
      "destination": "/official-sources",
      "permanent": true
    }
  ],
  "trailingSlash": false
}
