{
  "name": "madevisa",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "jobs:run": "tsx fetcher/run.ts",
    "jobs:local": "tsx fetcher/run.ts --local --force",
    "db:setup:local": "wrangler d1 execute madevisa --local --file=schema.sql"
  },
  "dependencies": {
    "linkedom": "^0.18.9",
    "sanitize-html": "^2.13.1",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@types/node": "^22.0.0",
    "@types/sanitize-html": "^2.13.0",
    "esbuild": "^0.24.0",
    "fflate": "^0.8.2",
    "pdfjs-dist": "3.11.174",
    "typescript": "^5.5.3",
    "wrangler": "^4.40.0"
  }
}
